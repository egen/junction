# ─── Claude Code harness runtime state (not project content) ──────
/.claude/worktrees/

# ─── Terraform / OpenTofu (generated into scaffolded target repos, and by
#     scripts/local-e2e-check.sh in a temp dir — kept here for safety) ──────
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
*.secret.tfvars
*.secrets.tfvars
*.tfplan
*.plan

# ─── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
.env
*.pyc
.pytest_cache/

# ─── Environment / Secrets ────────────────────────────────────────
.env
.env.*
!.env.example
.env-private
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
# Narrow, precise — NOT a bare `*secret*`/`*credentials*` substring match: that
# would silently exclude legitimate source files like store-secret.tf (a real
# Terraform resource file, not a secret).
*credentials*.json
*-key.json

# ─── MCP Server config (may contain tokens) ───────────────────────
.github/mcp-servers/.env
.github/mcp-servers/.env.*
!.github/mcp-servers/.env.example

# ─── Agent memory (local state, not committed) ────────────────────
.github/memories/*.md
# Optionally track memories — remove the line above and commit them

# ─── OS / Editor ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/settings.json
.vscode/.env
*.swp
*.swo
*~

# ─── IDEs ─────────────────────────────────────────────────────────
*.iml
.classpath
.project
.settings/

# ─── Logs ─────────────────────────────────────────────────────────
*.log
logs/

# ─── Archives ─────────────────────────────────────────────────────
*.zip
*.tar.gz
*.tgz
