# IaC Agent Platform — Master Configuration
# Generated by junction v{{ version }}
# Edit this file to customize your platform. Replace all placeholder values.

platform:
  name: "{{ platform.name }}"
  iac_tool: {{ platform.iac_tool }}               # terraform | opentofu | pulumi | cdk | cloudformation
  cloud: {{ platform.cloud }}                      # aws | gcp | azure | multi
  repo_name: "{{ platform.repo_name }}"
  description: "{{ platform.description }}"

# ─── Environment Chain ───────────────────────────────────────────
# Ordered from lowest to highest risk. The promotion path follows this order.
environments:
{% for env in platform.environments %}
  - name: {{ env.name }}
    branch: {{ env.branch }}
    account_id: "{{ env.account_id }}"
    prefix: "{{ env.prefix }}"
    risk_tier: {{ env.risk_tier }}                 # LOW = agent acts autonomously | MEDIUM = approval | HIGH = explicit confirm
    autonomous: {{ env.autonomous | lower }}
    profile: "{{ env.profile }}"
    tfvars: "{{ env.tfvars }}"
{% endfor %}

# ─── Compute Platform ────────────────────────────────────────────
compute:
  type: {{ platform.compute_type }}               # ecs_fargate | eks | lambda | ec2_asg | gke | aca
  cluster_naming: "{app}-{prefix}-{service}-cluster"
  service_naming: "{app}-{prefix}-{service}"
  health_endpoint_pattern: "/health"
  registry:
    type: {{ platform.container_registry }}        # ecr | gcr | acr | dockerhub | ghcr
    shared_account: ""                             # Cross-account image pull (optional)
    uri_pattern: "{{ registry_uri_pattern }}"
  image_source: tfvars                             # tfvars | versions_file | helm_values | ssm_parameter

# ─── CI/CD ────────────────────────────────────────────────────────
cicd:
  type: {{ platform.cicd_type }}                  # codebuild | github_actions | gitlab_ci | spacelift | atlantis
  plan_project: "{repo}-{env}-plan"
  apply_project: "{repo}-{env}-apply"
  log_group: "{{ cicd_log_group }}"
  lead_time_seconds: 90                            # Time from push to build start

# ─── Observability ────────────────────────────────────────────────
observability:
  apm:
    type: {{ platform.mcp.observability_backend }}  # newrelic | datadog | grafana | xray
    app_naming: "{app}-{prefix}-{service}"
    query_language: nrql                            # nrql | promql | dql
  logs:
    type: {{ platform.mcp.cloud_logs_backend }}     # cloudwatch | gcp_logging | azure_monitor
    group_pattern: "{app}/{service}/{prefix}"
  log_aggregator:
    type: {{ platform.mcp.log_aggregator_backend }} # opensearch | elasticsearch | loki | none
    index_pattern: "{app}-*"
  dashboards:
    auto_create: false

# ─── Issue Tracking ───────────────────────────────────────────────
issue_tracking:
  type: {{ platform.mcp.issue_tracker_backend }}   # jira | linear | github_issues | azure_devops
  project_prefix: "PROJ"
  ticket_pattern: "PROJ-\\d+"
  url: "https://your-org.atlassian.net"
  commit_format: "{type}({ticket}): {description}"

# ─── Naming Convention ────────────────────────────────────────────
# Kept in sync with .github/config/agent-graph.yml naming.pattern — the agent
# graph is the source of truth; edit there, not here, if it needs to change.
naming:
  application: "{{ platform.application_name }}"
  pattern: "{{ naming_pattern }}"

# ─── Deployment Policies ──────────────────────────────────────────
policies:
  timing:
    settle_time:       { dev: 120, staging: 180, prod: 300 }
    stability_window:  { dev: 300, staging: 600, prod: 900 }
    poll_interval:     60
    ci_lead_time:      90
    fix_lead_time:     120

  remediation:
    max_attempts: 3
    max_memory_bump_mb: 1024
    max_cpu_bump_units: 512
    rollback_age_limit_days: 7
    known_bad_tag_block: HARD
    same_error_retry: NEVER

  confidence_matrix:
    HIGH:   "Fix and re-enter loop"
    MEDIUM: "Fix once, then escalate"
    LOW:    "Escalate immediately"

# ─── Env-Leak Detection ──────────────────────────────────────────
leak_patterns: {}
  # Uncomment and fill to block cross-env value contamination:
  # dev_must_not_contain:
  #   - "{{ (platform.environments[1].account_id if platform.environments|length > 1 else 'staging-account') }}"
  # prod_must_not_contain:
  #   - "{{ (platform.environments[0].account_id if platform.environments else 'dev-account') }}"

# ─── MCP Server Configuration ────────────────────────────────────
mcp_servers:
  cloud_logs:
    enabled: {{ platform.mcp.cloud_logs_enabled | lower }}
    backend: {{ platform.mcp.cloud_logs_backend }}
    env_vars: {{ mcp_env_vars.cloud_logs | tojson }}
  issue_tracker:
    enabled: {{ platform.mcp.issue_tracker_enabled | lower }}
    backend: {{ platform.mcp.issue_tracker_backend }}
    env_vars: {{ mcp_env_vars.issue_tracker | tojson }}
  observability:
    enabled: {{ platform.mcp.observability_enabled | lower }}
    backend: {{ platform.mcp.observability_backend }}
    env_vars: {{ mcp_env_vars.observability | tojson }}
  log_aggregator:
    enabled: {{ platform.mcp.log_aggregator_enabled | lower }}
    backend: {{ platform.mcp.log_aggregator_backend }}
    env_vars: {{ mcp_env_vars.log_aggregator | tojson }}
